# PromptVista Environment Variables Example
# Copy this file to .env and fill in your values if using Supabase or analytics

# Optional: Supabase Database, Auth & Storage
# Get these from your Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: Public Site URL (used for canonical URLs and sitemaps)
VITE_SITE_URL=https://promptvista.pages.dev

# Optional: Plausible / Simple Analytics Domain
VITE_ANALYTICS_DOMAIN=
